    {
      "parameters": {
        "jsCode": "// The user replied directly to \"Send instruction message\" (forceReply),\n// so Telegram gives us that message back in reply_to_message.text,\n// including the #DATA# block we embedded in it.\nconst replyText = ($json.message && $json.message.reply_to_message && $json.message.reply_to_message.text) || '';\nconst match = replyText.match(/#DATA#(\\{[\\s\\S]*\\})/);\nconst data = match ? JSON.parse(match[1]) : {};\n\nreturn [{\n  json: {\n    Topic: data.t || '',\n    message: $json.message\n  }\n}];"
      },
