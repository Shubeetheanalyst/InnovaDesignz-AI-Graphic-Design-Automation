        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"mutation CreateFirstPost($input: CreatePostInput!) { createPost(input: $input) { ... on PostActionSuccess { post { id text dueAt } } ... on MutationError { message } } }\",\n  \"variables\": {\n    \"input\": {\n      \"text\": {{ \n        JSON.stringify(\n          $('Telegram Trigger').item.json.callback_query.message.caption\n            .match(/\\*Caption:\\*\\s*(.*?)\\s*\\*Hashtags:\\*\\s*(.*?)\\s*#DATA#/s)\n            .slice(1, 3)\n            .join('\\n')\n        )\n      }},\n      \"channelId\": \"{{ $json.data.channels[0].id }}\",\n      \"schedulingType\": \"automatic\",\n      \"mode\": \"shareNow\",\n      \"assets\": [\n        {\n          \"image\": {\n            \"url\": {{ \n              JSON.stringify(\n                JSON.parse(\n                  $('Telegram Trigger').item.json.callback_query.message.caption\n                    .split('#DATA#')[1]\n                ).i\n              )\n            }}\n          }\n        }\n      ],\n      \"metadata\": {\n        \"facebook\": {\n          \"type\": \"post\"\n        }\n      }\n    }\n  }\n}",
        "options": {}
