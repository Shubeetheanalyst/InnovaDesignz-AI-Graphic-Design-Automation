    {
      "parameters": {
        "jsCode": "const src = ($json.callback_query && $json.callback_query.message && $json.callback_query.message.caption) || '';\nconst match = src.match(/#DATA#(\\{[\\s\\S]*\\})/);\nconst data = match ? JSON.parse(match[1]) : {};\n\nconst headline = (src.match(/\\*Headline:\\*\\s*([\\s\\S]*?)\\n\\n/) || [])[1] || '';\nconst caption  = (src.match(/\\*Caption:\\*\\s*([\\s\\S]*?)\\n\\n/) || [])[1] || '';\nconst hashtags = (src.match(/\\*Hashtags:\\*\\s*([\\s\\S]*?)\\n\\n#DATA#/) || [])[1] || '';\n\nreturn [{\n  json: {\n    ...$json,\n    topic: data.t,\n    full_post_text: `${headline}\\n\\n${caption}\\n\\n${hashtags}`,\n    image: data.i\n  }\n}];"
      },
