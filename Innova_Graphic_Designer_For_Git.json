    {
      "parameters": {
        "jsCode": "// Embed topic / full post text / image url into the caption itself\n// (as a hidden #DATA# JSON block) so the Approve/Regenerate/Feedback\n// steps -- which run in a LATER, separate execution -- can recover it\n// straight from the Telegram message, with no external storage needed.\nconst parsed = $('Parse AI Output').first().json;\nconst cloudinary = $input.first().json;\n\nconst payload = {\n  t: parsed.topic,\n  i: cloudinary.secure_url\n};\n\nconst caption =\n  `🎨 *NEW POST FOR APPROVAL*\\n\\n` +\n  `*Headline:* ${parsed.headline}\\n\\n` +\n  `*Caption:* ${parsed.caption}\\n\\n` +\n  `*Hashtags:* ${parsed.hashtags}\\n\\n` +\n  `#DATA#${JSON.stringify(payload)}`;\n\n// Keep the binary image data flowing through to the photo-send node.\nreturn [{\n  json: { caption, image: cloudinary.secure_url },\n  binary: $input.first().binary\n}];"
      },
