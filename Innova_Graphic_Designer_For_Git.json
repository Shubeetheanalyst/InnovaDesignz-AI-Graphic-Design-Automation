        "jsCode": "// Clean raw JSON response from Gemini\nconst rawText = $input.first().json.content.parts[0].text;\nconst cleanText = rawText.replace(/```json|```/g, '').trim();\nconst parsedData = JSON.parse(cleanText);\n\n// Get topic from Set Node\nconst topic = $node[\"Initialize Sample Topics\"].json.Topic;\n\nreturn {\n  json: {\n    topic: topic,\n    headline: parsedData.headline,\n    caption: parsedData.caption,\n    hashtags: parsedData.hashtags,\n    image_prompt: parsedData.image_prompt,\n    full_post_text: `${parsedData.headline}\\n\\n${parsedData.caption}\\n\\n${parsedData.hashtags}`\n  }\n};"
