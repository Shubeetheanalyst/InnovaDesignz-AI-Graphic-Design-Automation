    {
      "parameters": {
        "jsCode": "// Pull #DATA# from the photo caption (Regenerate button's message)\n// and re-embed it into the instruction message we're about to send,\n// so the user's reply carries it through reply_to_message.\nconst src = ($json.callback_query && $json.callback_query.message && $json.callback_query.message.caption) || '';\nconst match = src.match(/#DATA#(\\{[\\s\\S]*\\})/);\nconst blob = match ? match[1] : '{}';\n\nconst text = `Kindly provide the instructions outlining the changes you would like to make.\\n\\n#DATA#${blob}`;\nreturn [{ json: { text } }];"
